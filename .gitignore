# Track authored source, notes, configuration, and selected challenge metadata only.
*
!*/
!*.md
!*.py
!*.rs
!*.sh
!*.nix
!*.lock
!*.toml
!.gitignore
!.envrc
!meta.json
!start.json
!result.json
!answers.json
!answers_full.json
!errors.json
!oracle.json

# Runtime trees contain metadata, not additional source or extracted challenges.
**/runs*/**
**/.rush-*/**
**/web-exploitation-*/**
!**/runs*/**/
!**/.rush-*/**/
!**/web-exploitation-*/**/
!**/meta.json
!**/start.json
!**/result.json
!**/answers.json
!**/answers_full.json
!**/errors.json
!**/oracle.json

# Never add payloads, fixtures, test material, builds, caches, or local secrets.
**/artifacts/
**/deliveries/
**/fixtures/
**/testdata/
**/tests/
**/test_*.py
**/*_test.py
**/target/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.direnv/
**/.venv/
**/.slot-*/
**/.env
**/.env.*
**/*-id_ed25519*
**/*.ovpn
**/.claude/settings.local.*
**/result
